<Window x:Class="AIMaster.AiManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIMaster" Icon="Resources/AIMaster.ico" ShowInTaskbar="True"
        Width="1280" Height="800" MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}"
        FontFamily="Microsoft YaHei UI" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#0B1220"/>
        <SolidColorBrush x:Key="Panel" Color="#111C2D"/>
        <SolidColorBrush x:Key="PanelRaised" Color="#17243A"/>
        <SolidColorBrush x:Key="InputSurface" Color="#0D1726"/>
        <SolidColorBrush x:Key="ButtonSurface" Color="#1A2940"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#233550"/>
        <SolidColorBrush x:Key="ButtonPressed" Color="#101C2D"/>
        <SolidColorBrush x:Key="Line" Color="#263750"/>
        <SolidColorBrush x:Key="LineStrong" Color="#36506F"/>
        <SolidColorBrush x:Key="Ink" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="Muted" Color="#9EADC2"/>
        <SolidColorBrush x:Key="Subtle" Color="#71839A"/>
        <SolidColorBrush x:Key="Signal" Color="#47D7AC"/>
        <SolidColorBrush x:Key="SignalInk" Color="#071A14"/>
        <SolidColorBrush x:Key="SignalSoft" Color="#153A34"/>
        <SolidColorBrush x:Key="SignalText" Color="#71E7C3"/>
        <SolidColorBrush x:Key="Warning" Color="#F2B95F"/>
        <SolidColorBrush x:Key="WarningSoft" Color="#382D1D"/>
        <SolidColorBrush x:Key="WarningBorder" Color="#6B542D"/>
        <SolidColorBrush x:Key="WarningText" Color="#F6D18E"/>
        <SolidColorBrush x:Key="Danger" Color="#F06B78"/>
        <SolidColorBrush x:Key="DangerSoft" Color="#3B222B"/>
        <SolidColorBrush x:Key="DangerBorder" Color="#75404B"/>
        <SolidColorBrush x:Key="DangerText" Color="#FFB7C0"/>
        <SolidColorBrush x:Key="MeterTrack" Color="#223249"/>
        <SolidColorBrush x:Key="ChartGrid" Color="#26364C"/>
        <SolidColorBrush x:Key="ChartBar" Color="#3A5364"/>
        <SolidColorBrush x:Key="FloatingShell" Color="#F5111C2D"/>
        <SolidColorBrush x:Key="FloatingPeek" Color="#70384A61"/>
        <SolidColorBrush x:Key="FloatingSecondaryInk" Color="#C5D0DE"/>
        <SolidColorBrush x:Key="Interrupted" Color="#BEA5F4"/>
        <SolidColorBrush x:Key="InterruptedSoft" Color="#302746"/>
        <SolidColorBrush x:Key="Idle" Color="#8294A8"/>
        <SolidColorBrush x:Key="IdleSoft" Color="#223147"/>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <DataTemplate x:Key="ResetAnnouncementTemplate">
            <Border Background="{DynamicResource InputSurface}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Heading}" Foreground="{DynamicResource SignalText}" FontSize="12"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource Ink}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="21" ToolTip="{Binding SummaryText}"/>
                    <TextBlock Text="{Binding LocalResetTimeText}" Foreground="{DynamicResource WarningText}"
                               FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="{Binding SourceActionText}" Tag="{Binding Url}" Click="ResetSource_Click"
                            Style="{DynamicResource ActionButton}" HorizontalAlignment="Right"
                            FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource ButtonSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.86"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SignalButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource Signal}"/>
            <Setter Property="Foreground" Value="{DynamicResource SignalInk}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Signal}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SidebarActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="DetailExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Chevron" Text="›" FontSize="18" Foreground="{TemplateBinding Foreground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
        </Style>
        <Style x:Key="PageButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="NavIcon" Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                <Ellipse x:Name="ActiveDot" Grid.Column="2" Width="5" Height="5" Fill="{DynamicResource Signal}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SignalSoft}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Signal}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SignalText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="tasks"><Setter TargetName="NavIcon" Property="Text" Value="&#xE8FD;"/></Trigger>
                            <Trigger Property="Tag" Value="usage"><Setter TargetName="NavIcon" Property="Text" Value="&#xE9D9;"/></Trigger>
                            <Trigger Property="Tag" Value="shared"><Setter TargetName="NavIcon" Property="Text" Value="&#xE753;"/></Trigger>
                            <Trigger Property="Tag" Value="settings"><Setter TargetName="NavIcon" Property="Text" Value="&#xE713;"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Signal}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardChromeButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Cascadia Mono"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="InsetSection" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputSurface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource PanelRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Handle" Background="{DynamicResource LineStrong}" CornerRadius="3" Margin="3,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource Muted}"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource Signal}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ThemedScrollBar" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Opacity="0.65" x:Name="ScrollRail">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton><RepeatButton x:Name="ScrollDecrease" Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb x:Name="ScrollHandle" Style="{StaticResource ScrollThumb}" MinHeight="28"/></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton x:Name="ScrollIncrease" Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollRail" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="ScrollHandle" Property="MinHeight" Value="0"/>
                                <Setter TargetName="ScrollHandle" Property="MinWidth" Value="28"/>
                                <Setter TargetName="ScrollDecrease" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                                <Setter TargetName="ScrollIncrease" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemedScrollBar}"/>
        <Style x:Key="DashboardScroller" TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
                <Grid Background="{TemplateBinding Background}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"
                                            Margin="{TemplateBinding Padding}"/>
                    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Width="12" Style="{StaticResource ThemedScrollBar}"
                               Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                               Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Height="12" Style="{StaticResource ThemedScrollBar}"
                               Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                               Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                               Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CardResizeThumb" TargetType="Thumb">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Signal}"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ScrollViewer x:Name="PART_ContentHost"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Signal}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Signal}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
                <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ScrollViewer x:Name="PART_ContentHost"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Signal}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="CheckSurface" Width="17" Height="17" VerticalAlignment="Top" Margin="0,1,0,0" CornerRadius="5" Background="{DynamicResource InputSurface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                        <Path x:Name="CheckMark" Data="M 3,7 L 6,10 L 12,4" Stroke="{DynamicResource SignalInk}" StrokeThickness="1.8" Visibility="Collapsed"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" Margin="10,0,0,0" RecognizesAccessKey="True"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="{DynamicResource Signal}"/><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{DynamicResource Signal}"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{DynamicResource Signal}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="RadioSurface" Width="17" Height="17" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource LineStrong}" Background="{DynamicResource InputSurface}">
                        <Ellipse x:Name="RadioDot" Width="7" Height="7" Fill="{DynamicResource Signal}" Visibility="Collapsed"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" Margin="8,0,0,0" RecognizesAccessKey="True"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="RadioSurface" Property="BorderBrush" Value="{DynamicResource Signal}"/><Setter TargetName="RadioDot" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RadioSurface" Property="BorderBrush" Value="{DynamicResource Signal}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource MeterTrack}"/>
            <Setter Property="Foreground" Value="{DynamicResource Signal}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Track" CornerRadius="4">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WorkspaceShell" Background="{DynamicResource AppBackground}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="NavigationRail" Grid.RowSpan="4" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="18,24,18,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="10,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" Background="{DynamicResource Signal}" CornerRadius="11" Margin="0,0,10,0">
                            <TextBlock Text="AI" Foreground="{DynamicResource SignalInk}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AIMaster" Foreground="{DynamicResource Ink}" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="控制中心" Foreground="{DynamicResource Subtle}" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource DashboardScroller}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,8">
                <StackPanel>
                    <Button x:Name="ResetAttentionButton" Visibility="Collapsed" Click="DismissResetAttention_Click"
                            Style="{StaticResource ActionButton}" Height="Auto" Padding="10,10" Margin="0,0,0,12"
                            HorizontalContentAlignment="Stretch" Background="{DynamicResource WarningSoft}"
                            BorderBrush="{DynamicResource Warning}" BorderThickness="2" Foreground="{DynamicResource WarningText}">
                        <StackPanel Width="148">
                            <TextBlock Text="● 最新重置信号" Foreground="{DynamicResource WarningText}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ResetAttentionTitle" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock x:Name="ResetAttentionDetail" Foreground="{DynamicResource WarningText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock x:Name="ResetAttentionAction" Foreground="{DynamicResource WarningText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="工作空间" Foreground="{DynamicResource Subtle}" FontSize="10" FontWeight="SemiBold" Margin="14,0,0,10"/>
                    <RadioButton x:Name="QuotaPageButton" Content="额度概览" Tag="quota" GroupName="DashboardPages" Style="{StaticResource PageButton}" Checked="DashboardPage_Checked"/>
                    <RadioButton x:Name="TasksPageButton" Content="任务监控" Tag="tasks" GroupName="DashboardPages" Style="{StaticResource PageButton}" Checked="DashboardPage_Checked"/>
                    <RadioButton x:Name="UsagePageButton" Content="用量分析" Tag="usage" GroupName="DashboardPages" Style="{StaticResource PageButton}" Checked="DashboardPage_Checked"/>
                    <RadioButton x:Name="SharedPageButton" Content="共享统计" Tag="shared" GroupName="DashboardPages" Style="{StaticResource PageButton}" Checked="DashboardPage_Checked"/>
                    <RadioButton x:Name="SettingsPageButton" Content="设置" Tag="settings" GroupName="DashboardPages" Style="{StaticResource PageButton}" Checked="DashboardPage_Checked"/>
                </StackPanel>
                </ScrollViewer>
                <Border x:Name="ApplicationControls" Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="外观与语言" Foreground="{DynamicResource Muted}" FontSize="11" Margin="4,0,0,8"/>
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <Button x:Name="LanguageButton" Content="EN" ToolTip="切换语言" Style="{StaticResource SidebarActionButton}" Click="LanguageButton_Click" Margin="0,0,4,0"/>
                            <Button x:Name="ThemeButton" Content="☀ 日间" ToolTip="切换到日间模式" Style="{StaticResource SidebarActionButton}" Click="ThemeButton_Click" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <TextBlock Text="版本与帮助" Foreground="{DynamicResource Muted}" FontSize="11" Margin="4,8,0,8"/>
                        <Button x:Name="CheckUpdateButton" Content="⇩ 检查更新" ToolTip="检查 GitHub 新版本"
                                Style="{StaticResource SidebarActionButton}" Click="CheckUpdate_Click" Margin="0,0,0,6"/>
                        <StackPanel>
                            <Button x:Name="ViewUpdateButton" Content="更新说明" ToolTip="查看最新版本的发布说明"
                                    Style="{StaticResource SidebarActionButton}" Click="ViewUpdate_Click" Margin="0,0,0,6" Visibility="Collapsed"/>
                            <Button x:Name="InstallUpdateButton" Content="⇩ 立即更新" ToolTip="下载并安装新版本"
                                    Style="{StaticResource SignalButton}" Height="30" Click="InstallUpdate_Click" Margin="0,0,0,6" Visibility="Collapsed"/>
                        </StackPanel>
                        <UniformGrid Columns="2">
                            <Button x:Name="OfficialWebsiteButton" Content="官网" ToolTip="在默认浏览器中打开 AIMaster 官网"
                                    Style="{StaticResource SidebarActionButton}" Click="OfficialWebsite_Click" Margin="0,0,4,0"/>
                            <Button x:Name="AboutButton" Content="关于" ToolTip="查看 AIMaster 信息与交流群"
                                    Style="{StaticResource SidebarActionButton}" Click="About_Click" Margin="4,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Grid.Row="0" Margin="18,12,18,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="WORKSPACE" Foreground="{DynamicResource Subtle}" FontFamily="Cascadia Mono" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Text=" / " Foreground="{DynamicResource LineStrong}" Margin="10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="PageBreadcrumbText" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SyncStatusText" Text="等待连接" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"
                           MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Button x:Name="FloatingWindowButton" Content="▣ 悬浮监控" Style="{StaticResource ActionButton}" Click="FloatingWindow_Click" Margin="0,0,8,0"/>
                <Button x:Name="RefreshButton" Content="↻ 立即同步" Style="{StaticResource SignalButton}" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Grid.Row="1" Margin="18,12,18,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="PageEyebrowText" Visibility="Collapsed" Foreground="{DynamicResource Signal}" FontFamily="Cascadia Mono" FontSize="10" Margin="0,0,0,8"/>
                <TextBlock x:Name="PageTitleText" Foreground="{DynamicResource Ink}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageDescriptionText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,12,0" LineHeight="18"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="PageIndexText" Visibility="Collapsed" Foreground="{DynamicResource LineStrong}" FontFamily="Cascadia Mono" FontSize="42" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer x:Name="DashboardScrollViewer" Style="{StaticResource DashboardScroller}" Grid.Column="1" Grid.Row="2" Margin="18,0,10,0" Padding="0,0,8,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <Grid x:Name="DashboardGrid">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                <Border x:Name="QuotaCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelCard}"
                        Background="{DynamicResource SignalSoft}" BorderBrush="{DynamicResource SignalSoft}">
                    <Grid>
                        <TextBlock Text="账户额度" Style="{StaticResource Label}"/>
                        <Grid x:Name="QuotaSummaryGrid" SizeChanged="SummaryGrid_SizeChanged">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="RemainingText" Text="--" Foreground="{DynamicResource Ink}" FontFamily="Cascadia Mono" FontSize="48" FontWeight="SemiBold"/>
                                    <TextBlock Text="%" Foreground="{DynamicResource SignalText}" FontSize="20" Margin="5,0,0,8" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <TextBlock Text="剩余额度" Foreground="{DynamicResource Muted}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel x:Name="QuotaSummaryDetails" Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                <WrapPanel>
                                    <Border x:Name="QuotaStateBadge" Background="{DynamicResource Panel}" CornerRadius="8" Padding="8,4" Margin="0,0,12,8">
                                        <TextBlock x:Name="QuotaStateText" Text="正在同步" Foreground="{DynamicResource SignalText}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock x:Name="ResetCreditText" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,8"/>
                                </WrapPanel>
                                <TextBlock x:Name="MainUsedText" Text="等待额度数据" Foreground="{DynamicResource Ink}" FontSize="13" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="MainUsageBar" Style="{StaticResource Meter}" Maximum="100" Value="0" Margin="0,10,0,0"/>
                                <TextBlock x:Name="MainResetText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Tag="CardHelp" Text="刻度线使用账户返回的百分比；不同模型可能拥有独立窗口。" Foreground="{DynamicResource Subtle}" FontSize="11"/>
                    </Grid>
                </Border>

                <Border x:Name="GuardCard" Grid.Row="0" Grid.Column="2" Style="{StaticResource PanelCard}">
                    <Grid>
                        <TextBlock Text="任务闸门" Style="{StaticResource Label}"/>
                        <Grid x:Name="GuardSummaryGrid" SizeChanged="SummaryGrid_SizeChanged">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="GuardGlyph" Text="GO" Foreground="{DynamicResource Signal}" FontFamily="Cascadia Mono" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="GuardStatusText" Text="额度安全，当前无需暂停" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="GuardDetailText" Text="达到暂停线后中断当前连接可见任务" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel x:Name="GuardActions" Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                <Button x:Name="PauseNowButton" Content="暂停可见任务" Style="{StaticResource DangerButton}" Click="PauseNow_Click" Margin="0,0,8,4"/>
                                <Button x:Name="ResumeGuardButton" Content="解除本地闸门" Style="{StaticResource ActionButton}" Margin="0,0,0,4" Click="ResumeGuard_Click" Visibility="Collapsed"/>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="LimitsCard" Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="其他额度窗口" Style="{StaticResource Label}"/>
                        <TextBlock Tag="CardHelp" Grid.Row="1" Text="账户可能同时返回总额度和特定模型额度；守卫以最高占用为准。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,7"/>
                        <ItemsControl x:Name="LimitItems" Grid.Row="2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8,0,16">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Ink}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding WindowName}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding RemainingText}" Foreground="{DynamicResource Ink}" FontFamily="Cascadia Mono" FontSize="11"/>
                                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <ProgressBar Style="{StaticResource Meter}" Maximum="100" Value="{Binding UsedPercent}"/>
                                            <TextBlock Grid.Row="1" Text="{Binding ResetText}" Foreground="{DynamicResource Subtle}" FontSize="10"
                                                       HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border x:Name="ResetSignalsCard" Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="重置信号" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="ResetSignalStatusText" Text="等待重置信号" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="ResetLastAnnouncementText" Text="上次重置记录未知" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0"/>
                        <ItemsControl x:Name="ResetSignalItems" Margin="0,12,0,0" ItemTemplate="{StaticResource ResetAnnouncementTemplate}"/>
                        <Expander x:Name="ResetHistoryExpander" Header="历史公告" Style="{StaticResource DetailExpander}" Margin="0,2,0,8" IsExpanded="False" Visibility="Collapsed">
                            <ItemsControl x:Name="ResetHistoryItems" Margin="0,10,0,0" ItemTemplate="{StaticResource ResetAnnouncementTemplate}"/>
                        </Expander>
                        <TextBlock x:Name="ResetAccountRecoveryText" Text="官方账号数据：尚未检测到额度恢复"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Ink}" FontSize="12" Margin="0,8,0,0"/>
                        <Expander Header="监测设置" Style="{StaticResource DetailExpander}" Margin="0,14,0,0" IsExpanded="False">
                            <StackPanel Margin="0,10,0,0">
                                <CheckBox x:Name="ResetMonitoringCheck" Foreground="{DynamicResource Ink}" Margin="0,0,0,10"
                                          Checked="ResetSettings_Changed" Unchecked="ResetSettings_Changed">
                                    <TextBlock Text="自动监测重置信号（每 2 分钟）" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox x:Name="ResetNotificationsCheck" Foreground="{DynamicResource Ink}"
                                          Checked="ResetSettings_Changed" Unchecked="ResetSettings_Changed">
                                    <TextBlock Text="新信号及账号额度恢复时通知" TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                        </Expander>
                        <TextBlock Tag="CardHelp" Text="社区转述和预告不代表额度已到账；以官方账号数据为准。"
                                   Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <Button Tag="https://codex-reset.com/zh/" Click="ResetSource_Click"
                                Style="{StaticResource ActionButton}" HorizontalAlignment="Left" MinHeight="30" Height="Auto" FontSize="11"
                                Padding="10,6" Margin="0,12,0,0">
                            <TextBlock Text="数据来源：codex-reset.com" TextWrapping="Wrap"/>
                        </Button>
                        <TextBlock x:Name="ResetCheckedText" Text="每 2 分钟自动检查" Foreground="{DynamicResource Subtle}"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock x:Name="ResetNotificationStatusText" Foreground="{DynamicResource Subtle}"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ForecastCard" Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="消耗预测 / 本周" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="AccountForecastButton" Content="账号" Style="{StaticResource SignalButton}"
                                        Height="26" Padding="11,0" FontSize="11" Click="ForecastScope_Click"/>
                                <Button x:Name="LocalForecastButton" Content="本机" Style="{StaticResource ActionButton}"
                                        Height="26" Padding="11,0" FontSize="11" Margin="5,0,0,0" Click="ForecastScope_Click"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,9,0,0">
                            <TextBlock x:Name="ForecastSummaryText" Text="等待数据" Foreground="{DynamicResource Ink}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Tag="CardHelp" x:Name="ForecastScopeNoteText" Text="汇总该账号所有设备的用量" Foreground="{DynamicResource Muted}"
                                       FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Row="2" Margin="0,15,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="128"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="本周剩余额度" Style="{StaticResource Label}"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0">
                                    <Rectangle Width="15" Height="2" Fill="{DynamicResource Signal}" VerticalAlignment="Center"/>
                                    <TextBlock Text="估算" Foreground="{DynamicResource Muted}" FontSize="10" Margin="5,0,10,0"/>
                                    <Rectangle Width="15" Height="2" Fill="{DynamicResource Warning}" VerticalAlignment="Center"/>
                                    <TextBlock Text="预测" Foreground="{DynamicResource Muted}" FontSize="10" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Margin="0,7,0,0" Background="{DynamicResource InputSurface}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" CornerRadius="7" Padding="5">
                                <Canvas x:Name="RemainingForecastCanvas" ClipToBounds="True"
                                        SizeChanged="RemainingForecastCanvas_SizeChanged"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="3" Margin="0,13,0,8">
                            <TextBlock Text="近 7 日 TOKEN" Style="{StaticResource Label}"/>
                            <StackPanel x:Name="UsageBarsPanel" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,18,0,0" Height="60"/>
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="日均 TOKEN" Style="{StaticResource Label}" FontFamily="Cascadia Mono"/>
                                <TextBlock x:Name="DailyTokensText" Text="--" Foreground="{DynamicResource Ink}" FontFamily="Cascadia Mono" FontSize="17" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="日均额度" Style="{StaticResource Label}" FontFamily="Cascadia Mono" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="DailyPercentText" Text="--" Foreground="{DynamicResource Ink}" FontFamily="Cascadia Mono" FontSize="17" Margin="0,3,0,0" HorizontalAlignment="Right"/></StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="ThreadsCard" Grid.Row="2" Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="最近任务" Style="{StaticResource Label}"/>
                        <TextBlock Tag="CardHelp" Grid.Row="1" Text="运行态只对当前 App Server 连接可见；其他 Codex 窗口可能显示为历史记录。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,9"/>
                        <ListBox x:Name="ThreadList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="TaskSurface" Background="{DynamicResource InputSurface}" CornerRadius="12" Padding="10" BorderThickness="1" BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TaskSurface" Property="BorderBrush" Value="{DynamicResource Signal}"/></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TaskSurface" Property="Background" Value="{DynamicResource PanelRaised}"/></Trigger>
                                            <DataTrigger Binding="{Binding Status}" Value="waitingOnApproval">
                                                <Setter TargetName="TaskSurface" Property="Background" Value="{DynamicResource WarningSoft}"/>
                                                <Setter TargetName="TaskSurface" Property="BorderBrush" Value="{DynamicResource WarningBorder}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="waitingOnUserInput">
                                                <Setter TargetName="TaskSurface" Property="Background" Value="{DynamicResource WarningSoft}"/>
                                                <Setter TargetName="TaskSurface" Property="BorderBrush" Value="{DynamicResource WarningBorder}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Status}" Value="waitingOnApproval"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="TaskSurface" Property="BorderBrush" Value="{DynamicResource Warning}"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Status}" Value="waitingOnApproval"/>
                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="TaskSurface" Property="BorderBrush" Value="{DynamicResource Warning}"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Status}" Value="waitingOnUserInput"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="TaskSurface" Property="BorderBrush" Value="{DynamicResource Warning}"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Status}" Value="waitingOnUserInput"/>
                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="TaskSurface" Property="BorderBrush" Value="{DynamicResource Warning}"/>
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate></Setter.Value></Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3" ToolTip="{Binding DisplayTitle}">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" Text="{Binding DisplayTitle}" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" LineHeight="22" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal"><Ellipse x:Name="TaskStatusDot" Width="5" Height="5" Fill="{DynamicResource Signal}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TaskStatusLabel" Text="{Binding StatusText}" Foreground="{DynamicResource Signal}" FontSize="11" Margin="0,0,12,0"/></StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdatedText}" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="waitingOnApproval">
                                            <Setter TargetName="TaskStatusDot" Property="Fill" Value="{DynamicResource WarningText}"/>
                                            <Setter TargetName="TaskStatusLabel" Property="Foreground" Value="{DynamicResource WarningText}"/>
                                            <Setter TargetName="TaskStatusLabel" Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="waitingOnUserInput">
                                            <Setter TargetName="TaskStatusDot" Property="Fill" Value="{DynamicResource WarningText}"/>
                                            <Setter TargetName="TaskStatusLabel" Property="Foreground" Value="{DynamicResource WarningText}"/>
                                            <Setter TargetName="TaskStatusLabel" Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border x:Name="SettingsCard" Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="保护策略" Style="{StaticResource Label}"/>
                        <Border Grid.Row="1" Style="{StaticResource InsetSection}">
                        <StackPanel>
                        <TextBlock Text="安全阈值与通知" Style="{StaticResource SectionLabel}"/>
                        <Grid x:Name="PolicySectionsGrid" SizeChanged="PolicySectionsGrid_SizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="200"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="预警线" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="WarningPercentBox" Grid.Column="1" Text="70" FontFamily="Cascadia Mono" HorizontalContentAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="暂停线" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,10,12,0"/>
                            <TextBox x:Name="PausePercentBox" Grid.Row="1" Grid.Column="1" Text="90" FontFamily="Cascadia Mono" HorizontalContentAlignment="Right" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="2" Text="浮窗字号（100–150%）" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,10,12,0"/>
                            <TextBox x:Name="FloatingFontPercentBox" Grid.Row="2" Grid.Column="1" Text="120" FontFamily="Cascadia Mono"
                                     HorizontalContentAlignment="Right" Margin="0,10,0,0"/>
                            <CheckBox x:Name="AutoPauseCheck" Grid.Row="3" Grid.ColumnSpan="2" Foreground="{DynamicResource Ink}" Margin="0,14,0,0">
                                <TextBlock Text="超出暂停线时中断可见任务并提示（窗口打开时监控）" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="QuotaNotificationsCheck" Grid.Row="4" Grid.ColumnSpan="2" Foreground="{DynamicResource Ink}" Margin="0,10,0,0">
                                <TextBlock Text="额度预警通知栏提示" TextWrapping="Wrap"/>
                            </CheckBox>
                        </Grid>
                            <StackPanel x:Name="DailyBudgetPanel" Grid.Column="2">
                                <TextBlock Text="每日用量预算" Style="{StaticResource SectionLabel}"/>
                                <CheckBox x:Name="DailyQuotaWarningCheck" Foreground="{DynamicResource Ink}">
                                    <TextBlock Text="启用每日账号额度预警" TextWrapping="Wrap"/>
                                </CheckBox>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="200"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="每日预警线（0.1–100%）" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="DailyQuotaLimitBox" Grid.Column="1" Text="10" FontFamily="Cascadia Mono" HorizontalContentAlignment="Right"/>
                                </Grid>
                                <TextBlock x:Name="DailyQuotaStatusText" Text="等待每日额度数据" Foreground="{DynamicResource Subtle}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                                <TextBlock Tag="CardHelp" Text="按账号本周期 Token 比例与周额度占用估算，包含所有设备；非官方每日额度账单。" Foreground="{DynamicResource Subtle}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
                                <TextBlock x:Name="DailyRecommendationText" Text="完整用量数据不足，暂不能推荐；可手动填写。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                                <Button x:Name="UseDailyRecommendationButton" Content="使用推荐值" Style="{StaticResource ActionButton}" Click="UseDailyRecommendation_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                        </Border>
                        <Button Grid.Row="2" Content="保存并应用" Style="{StaticResource SignalButton}" HorizontalAlignment="Right" Click="SavePolicy_Click"/>
                    </Grid>
                </Border>

                <Border x:Name="LocalUsageCard" Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="本机消耗" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="LocalUsageTokensText" Text="--" Foreground="{DynamicResource Ink}"
                                       FontFamily="Cascadia Mono" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="TOKEN / 本周" Foreground="{DynamicResource Muted}" FontFamily="Cascadia Mono" FontSize="11"/>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="常用模型" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                <TextBlock x:Name="LocalUsageModelText" Grid.Column="1" Text="--" Foreground="{DynamicResource Ink}"
                                           FontFamily="Cascadia Mono" FontSize="11" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <TextBlock x:Name="LocalUsageDetailText" Text="等待本地记录" Foreground="{DynamicResource Muted}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,9,18,0"/>
                            <TextBlock x:Name="LocalUsageEstimateText" Text="等待账户与本机记录" Foreground="{DynamicResource Signal}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,8,18,0"/>
                            <TextBlock Tag="CardHelp" Text="本机 Token 来自本地会话日志；账户 Token 来自 Codex 用量历史。" Foreground="{DynamicResource Subtle}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,8,18,0"/>
                            <TextBlock Tag="CardHelp" Text="额度占比按同周期 Token 比例估算，不等于官方设备账单。" Foreground="{DynamicResource Subtle}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,5,18,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Height="1" Background="{DynamicResource Line}" Margin="0,10,0,0"/>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="项目消耗分布" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="ProjectUsageCountText" Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right" Margin="8,0,0,0"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,9,0,0">
                                <TextBlock x:Name="LocalUsageEmptyText" Text="本周暂无本地 Token 记录" Foreground="{DynamicResource Muted}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ItemsControl x:Name="ProjectUsageItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,0,9" ToolTip="{Binding ProjectPath}">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ProjectName}" Foreground="{DynamicResource Ink}" FontSize="12"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TokensText}" Foreground="{DynamicResource Ink}"
                                                           FontFamily="Cascadia Mono" FontSize="11" Margin="12,0,0,0"/>
                                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Meter}" Maximum="100"
                                                             Value="{Binding WeeklyQuotaBarValue, Mode=OneWay}" Margin="0,6,0,0"/>
                                                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding MostUsedModelText}" Foreground="{DynamicResource Muted}"
                                                               FontFamily="Cascadia Mono" FontSize="10" Margin="0,0,12,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding QuotaShareText}" Foreground="{DynamicResource Muted}"
                                                               FontFamily="Cascadia Mono" FontSize="10" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="DailyUsageCard" Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="当日消耗 / 时段" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="DailyUsageTokensText" Text="--" Foreground="{DynamicResource Ink}"
                                       FontFamily="Cascadia Mono" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="TOKEN / 今日" Foreground="{DynamicResource Muted}" FontFamily="Cascadia Mono" FontSize="11"/>
                            <TextBlock x:Name="DailyUsageShareText" Text="周总额度占比暂不可用" Foreground="{DynamicResource Signal}"
                                       FontFamily="Cascadia Mono" FontSize="11" TextWrapping="Wrap" Margin="0,12,18,0"/>
                            <TextBlock Tag="CardHelp" Text="按账号本周 Token 历史与周窗口已用比例估算，不是官方逐日账单。"
                                       Foreground="{DynamicResource Subtle}" FontSize="11" TextWrapping="Wrap" Margin="0,9,18,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Height="1" Background="{DynamicResource Line}" Margin="0,10,0,0"/>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="今日每小时消耗" Style="{StaticResource Label}"/>
                                <TextBlock Grid.Row="1" Text="00–23 时" Foreground="{DynamicResource Muted}" FontFamily="Cascadia Mono"
                                           FontSize="10" Margin="0,5,0,0"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,10,0,0" MinHeight="110">
                                <Canvas x:Name="DailyUsageCanvas" Height="110" ClipToBounds="True"
                                        SizeChanged="DailyUsageCanvas_SizeChanged"/>
                                <TextBlock x:Name="DailyUsageEmptyText" Text="今日暂无本机 Token" Foreground="{DynamicResource Muted}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="SharedUsageCard" Grid.Row="5" Grid.ColumnSpan="3" Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                    <Grid x:Name="SharedLayoutGrid" SizeChanged="SharedLayoutGrid_SizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.ColumnSpan="3">
                            <TextBlock Text="共享统计" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="SharedUsageSummaryText" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Tag="CardHelp" Grid.Row="1" Grid.ColumnSpan="3" Text="使用相同同步密钥的设备归为一组；不会上传 Codex 凭证、任务内容、项目名称或路径。"
                                   Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,10"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="SharedUsageEnabledCheck" Grid.ColumnSpan="2" Content="启用共享统计"
                                      Foreground="{DynamicResource Ink}"/>
                            <TextBlock Grid.Row="1" Text="服务器地址" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="0,9,8,0"/>
                            <TextBox x:Name="SharedUsageServerUrlBox" Grid.Row="1" Grid.Column="1"
                                     Text="https://www.woliux.com" Margin="0,9,0,0"/>
                            <TextBlock Grid.Row="2" Text="设备名称" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="0,9,8,0"/>
                            <TextBox x:Name="SharedUsageDeviceNameBox" Grid.Row="2" Grid.Column="1" Margin="0,9,0,0"/>
                            <TextBlock Grid.Row="3" Text="同步密钥" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="0,9,8,0"/>
                            <Grid Grid.Row="3" Grid.Column="1" Margin="0,9,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <PasswordBox x:Name="SharedUsageSyncKeyBox" Background="{DynamicResource InputSurface}" Foreground="{DynamicResource Ink}"
                                             BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" Padding="9,6"/>
                                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                    <Button Content="生成密钥" Style="{StaticResource ActionButton}" Height="30"
                                            Padding="9,0" Margin="0,0,7,6" Click="GenerateSharedSyncKey_Click"/>
                                    <Button Content="复制密钥" Style="{StaticResource ActionButton}" Height="30"
                                            Padding="9,0" Margin="0,0,0,6" Click="CopySharedSyncKey_Click"/>
                                </WrapPanel>
                            </Grid>
                            <TextBlock Grid.Row="4" Text="清零方式" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="0,12,8,0"/>
                            <WrapPanel Grid.Row="4" Grid.Column="1" Margin="0,12,0,0">
                                <RadioButton x:Name="SharedUsageWeeklyRadio" GroupName="SharedUsageResetMode" Content="固定每周"
                                             Foreground="{DynamicResource Ink}" Margin="0,0,18,5" Checked="SharedUsageResetMode_Checked"/>
                                <RadioButton x:Name="SharedUsageAccountResetRadio" GroupName="SharedUsageResetMode" Content="重置时清零"
                                             Foreground="{DynamicResource Ink}" Margin="0,0,18,5" Checked="SharedUsageResetMode_Checked"/>
                                <RadioButton x:Name="SharedUsageNeverRadio" GroupName="SharedUsageResetMode" Content="不清零"
                                             IsChecked="True" Foreground="{DynamicResource Ink}" Margin="0,0,0,5" Checked="SharedUsageResetMode_Checked"/>
                            </WrapPanel>
                            <TextBlock Tag="CardHelp" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,5,0,0" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"
                                       Text="固定每周：本周一至今；重置时清零：上次官方周额度重置至今；不清零：持续累计。仅影响当前设备，切换后立即保存并按时间范围重新计算。"/>
                            <TextBlock x:Name="SharedUsagePeriodText" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,7,0,0"
                                       Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Text="当前设备统计范围：全部本地历史"/>
                            <WrapPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,9,0,0">
                                <Button x:Name="SharedUsageClearButton" Content="手动清零" Style="{StaticResource ActionButton}"
                                        Height="30" Margin="0,0,9,0" Click="ClearSharedUsage_Click"
                                        ToolTip="仅清零当前设备的共享计数，不删除本地会话记录。"/>
                                <Button x:Name="SharedUsageRestoreButton" Content="恢复" Style="{StaticResource ActionButton}"
                                        Height="30" IsEnabled="False" Click="RestoreSharedUsage_Click"
                                        ToolTip="撤销当前方式最近一次手动清零，并保留之后新增用量；仍按所选时间范围统计。"/>
                            </WrapPanel>
                        </Grid>
                        <Grid Grid.Row="3" Margin="0,10,0,10">
                            <TextBlock x:Name="SharedUsageStatusText" Text="等待共享设置" Foreground="{DynamicResource Signal}"
                                       FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,118,0"/>
                            <Button x:Name="SharedUsageSaveButton" Content="保存并同步" Style="{StaticResource SignalButton}"
                                    Height="32" HorizontalAlignment="Right" Click="SaveSharedUsage_Click"/>
                        </Grid>
                        <Border x:Name="SharedDevicesPanel" Grid.Row="2" Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource InsetSection}" Margin="0">
                        <Grid MinHeight="100">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="设备用量" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="SharedUsageEmptyText" Grid.Row="1" Text="暂无共享设备数据" Foreground="{DynamicResource Muted}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <ItemsControl x:Name="SharedDeviceItems" Grid.Row="1">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,11" ToolTip="{Binding DeviceId}">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,12,0">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="{Binding DeviceName}" Foreground="{DynamicResource Ink}" FontSize="12"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="1" Text="{Binding CurrentDeviceText}" Foreground="{DynamicResource Signal}" FontSize="10" Margin="0,4,0,0"/>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding TokensText}" Foreground="{DynamicResource Ink}"
                                                       FontFamily="Cascadia Mono" FontSize="11" Margin="12,0,0,0"/>
                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Meter}" Maximum="100"
                                                         Value="{Binding TokenSharePercent}" Margin="0,6,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ShareText}" Foreground="{DynamicResource Muted}"
                                                       FontFamily="Cascadia Mono" FontSize="10" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                            <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="{Binding ModelText}" Foreground="{DynamicResource Muted}" FontFamily="Cascadia Mono" FontSize="10" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="1" Text="{Binding DetailText}" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Column="1" Grid.Row="3" Margin="18,8,18,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatusText" Text="数据只保存在本机；认证由 Codex 管理。" Foreground="{DynamicResource Subtle}"
                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <TextBlock x:Name="LastSyncText" Grid.Column="1" Text="" Foreground="{DynamicResource Subtle}"
                       FontFamily="Cascadia Mono" FontSize="10" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
