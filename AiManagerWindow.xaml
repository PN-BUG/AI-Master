<Window x:Class="AIMaster.AiManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIMaster" Icon="Resources/AIMaster.ico" ShowInTaskbar="True"
        Width="1180" Height="790" MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#0F151B"
        FontFamily="Microsoft YaHei UI" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#172028"/>
        <SolidColorBrush x:Key="PanelRaised" Color="#1D2832"/>
        <SolidColorBrush x:Key="Line" Color="#2C3944"/>
        <SolidColorBrush x:Key="Ink" Color="#F1F5F2"/>
        <SolidColorBrush x:Key="Muted" Color="#92A39B"/>
        <SolidColorBrush x:Key="Signal" Color="#22C58B"/>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#22303A"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#354650"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#2B3B46"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#18242C"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SignalButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource Signal}"/>
            <Setter Property="Foreground" Value="#07120E"/>
            <Setter Property="BorderBrush" Value="{StaticResource Signal}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#3A2528"/>
            <Setter Property="Foreground" Value="#FFB4B8"/>
            <Setter Property="BorderBrush" Value="#714047"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#10181E"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#354650"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource Signal}"/>
        </Style>
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Background" Value="#293640"/>
            <Setter Property="Foreground" Value="{StaticResource Signal}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Track" CornerRadius="4">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AI / CONTROL DESK" Foreground="{StaticResource Signal}" FontFamily="Cascadia Mono"
                           FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="AIMaster" Foreground="{StaticResource Ink}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                <TextBlock Text="看清额度跑道，在撞线之前停下来。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SyncStatusText" Text="等待连接" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="CheckUpdateButton" Content="⇩ 检查更新" ToolTip="检查 GitHub 新版本"
                        Style="{StaticResource ActionButton}" Click="CheckUpdate_Click" Margin="0,0,8,0"/>
                <Button x:Name="InstallUpdateButton" Content="⇩ 立即更新" ToolTip="下载并安装新版本"
                        Style="{StaticResource SignalButton}" Click="InstallUpdate_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
                <Button x:Name="LanguageButton" Content="EN" ToolTip="切换语言" Style="{StaticResource ActionButton}" Click="LanguageButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="FloatingWindowButton" Content="▣ 悬浮监控" Style="{StaticResource ActionButton}" Click="FloatingWindow_Click" Margin="0,0,8,0"/>
                <Button x:Name="RefreshButton" Content="↻ 立即同步" Style="{StaticResource SignalButton}" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <Border x:Name="ConnectionBanner" Grid.Row="1" Background="#2B2417" BorderBrush="#665128" BorderThickness="1"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
            <TextBlock x:Name="ConnectionText" Foreground="#F2CD7D" TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelCard}" MinHeight="220">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="主额度跑道" Style="{StaticResource Label}"/>
                            <Border x:Name="QuotaStateBadge" HorizontalAlignment="Right" Background="#18382D" CornerRadius="10" Padding="9,3">
                                <TextBlock x:Name="QuotaStateText" Text="正在同步" Foreground="#68E0B2" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,18,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="RemainingText" Text="--" Foreground="{StaticResource Ink}" FontFamily="Cascadia Mono" FontSize="58" FontWeight="SemiBold"/>
                                    <TextBlock Text="%" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono" FontSize="20" Margin="5,0,0,9"/>
                                </StackPanel>
                                <TextBlock Text="REMAINING" Style="{StaticResource Label}" FontFamily="Cascadia Mono"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,0,0">
                                <Grid><TextBlock Text="0" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono" FontSize="10"/>
                                    <TextBlock Text="LIMIT" Foreground="#667881" FontFamily="Cascadia Mono" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Text="100" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                <ProgressBar x:Name="MainUsageBar" Style="{StaticResource Meter}" Maximum="100" Value="0" Margin="0,7,0,0"/>
                                <Grid Margin="0,9,0,0">
                                    <TextBlock x:Name="MainUsedText" Text="等待额度数据" Foreground="{StaticResource Ink}" FontSize="12"/>
                                    <TextBlock x:Name="MainResetText" Text="" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="刻度线使用账户返回的百分比；不同模型可能拥有独立窗口。" Foreground="#71838A" FontSize="11"/>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource PanelCard}" MinHeight="220">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="任务闸门" Style="{StaticResource Label}"/>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock x:Name="GuardGlyph" Text="GO" Foreground="{StaticResource Signal}" FontFamily="Cascadia Mono" FontSize="44" FontWeight="Bold"/>
                            <TextBlock x:Name="GuardStatusText" Text="额度安全，当前无需暂停" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            <TextBlock x:Name="GuardDetailText" Text="达到暂停线后中断当前连接可见任务" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button x:Name="PauseNowButton" Content="暂停可见任务" Style="{StaticResource DangerButton}" Click="PauseNow_Click"/>
                            <Button x:Name="ResumeGuardButton" Content="解除本地闸门" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="ResumeGuard_Click" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,12,0,0" MinHeight="235">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><TextBlock Text="额度窗口" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="ResetCreditText" Text="" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/></Grid>
                        <TextBlock Grid.Row="1" Text="账户可能同时返回总额度和特定模型额度；守卫以最高占用为准。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,10"/>
                        <ItemsControl x:Name="LimitItems" Grid.Row="2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5,0,8">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding WindowName, StringFormat= · {0}}" Foreground="{StaticResource Muted}" FontSize="11" Margin="4,1,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding RemainingText}" Foreground="{StaticResource Ink}" FontFamily="Cascadia Mono" FontSize="11"/>
                                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                            <ProgressBar Style="{StaticResource Meter}" Maximum="100" Value="{Binding UsedPercent}"/>
                                            <TextBlock Text="{Binding ResetText}" Foreground="#789098" FontSize="9" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelCard}" Margin="0,12,0,0" MinHeight="235">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="消耗预测 / 近 7 日" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="ForecastSummaryText" Grid.Row="1" Text="等待数据" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap"/>
                        <StackPanel x:Name="UsageBarsPanel" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,18,0,8" Height="88"/>
                        <Grid Grid.Row="3">
                            <StackPanel><TextBlock Text="日均 TOKEN" Style="{StaticResource Label}" FontFamily="Cascadia Mono"/>
                                <TextBlock x:Name="DailyTokensText" Text="--" Foreground="{StaticResource Ink}" FontFamily="Cascadia Mono" FontSize="17" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel HorizontalAlignment="Right"><TextBlock Text="日均额度" Style="{StaticResource Label}" FontFamily="Cascadia Mono" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="DailyPercentText" Text="--" Foreground="{StaticResource Ink}" FontFamily="Cascadia Mono" FontSize="17" Margin="0,3,0,0" HorizontalAlignment="Right"/></StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,12,0,0" MinHeight="215">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="最近任务" Style="{StaticResource Label}"/>
                        <TextBlock Grid.Row="1" Text="运行态只对当前 App Server 连接可见；其他 Codex 窗口可能显示为历史记录。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,9"/>
                        <ListBox x:Name="ThreadList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5" ToolTip="{Binding Id}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource Signal}" FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding UpdatedText}" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelCard}" Margin="0,12,0,0" MinHeight="215">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="保护策略" Style="{StaticResource Label}"/>
                        <Grid Grid.Row="1" Margin="0,12,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="预警线" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                            <TextBox x:Name="WarningPercentBox" Grid.Column="1" Text="70" FontFamily="Cascadia Mono" HorizontalContentAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="暂停线" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBox x:Name="PausePercentBox" Grid.Row="1" Grid.Column="1" Text="90" FontFamily="Cascadia Mono" HorizontalContentAlignment="Right" Margin="0,10,0,0"/>
                            <CheckBox x:Name="AutoPauseCheck" Grid.Row="2" Grid.ColumnSpan="2" Content="超出暂停线时中断可见任务并提示（窗口打开时监控）" Foreground="{StaticResource Ink}" Margin="0,14,0,0"/>
                        </Grid>
                        <Button Grid.Row="2" Content="保存并应用" Style="{StaticResource SignalButton}" HorizontalAlignment="Right" Click="SavePolicy_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="2,13,2,0">
            <TextBlock x:Name="FooterStatusText" Text="数据只保存在本机；认证由 Codex 管理。" Foreground="#71838A" FontSize="11"/>
            <TextBlock x:Name="LastSyncText" Text="" Foreground="#71838A" FontFamily="Cascadia Mono" FontSize="10" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
