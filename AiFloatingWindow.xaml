<Window x:Class="AIMaster.AiFloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 任务悬浮监控" Width="200" MinWidth="180" Height="98" MinHeight="98"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Icon="Resources/AIMaster.ico" ShowInTaskbar="False" Topmost="True"
        FontFamily="Microsoft YaHei UI" Loaded="Window_Loaded" Closed="Window_Closed"
        SizeChanged="Window_SizeChanged" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">
    <Window.ContextMenu>
        <ContextMenu x:Name="FloatingMenu" Opened="FloatingMenu_Opened">
            <MenuItem x:Name="RefreshNowMenuItem" Header="立即刷新" Click="RefreshNow_Click"/>
            <MenuItem x:Name="CollapseToggleMenuItem" Header="立即收起" Click="CollapseToggle_Click"/>
            <MenuItem x:Name="AutoCollapseMenuItem" Header="靠边自动收起" IsCheckable="True"
                      Click="AutoCollapseMenuItem_Click"/>
            <Separator/>
            <MenuItem x:Name="TaskNameSourceMenuItem" Header="任务名称显示">
                <MenuItem x:Name="ConversationTitleMenuItem" Header="对话标题" Tag="conversationTitle"
                          IsCheckable="True" Click="TaskNameSource_Click"/>
                <MenuItem x:Name="LatestUserMessageMenuItem" Header="最后发送内容" Tag="latestUserMessage"
                          IsCheckable="True" Click="TaskNameSource_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem x:Name="RefreshFrequencyMenuItem" Header="刷新频率">
                <MenuItem Header="1 秒" Tag="1" IsCheckable="True" Click="RefreshFrequency_Click"/>
                <MenuItem Header="2 秒" Tag="2" IsCheckable="True" Click="RefreshFrequency_Click"/>
                <MenuItem Header="5 秒" Tag="5" IsCheckable="True" Click="RefreshFrequency_Click"/>
                <MenuItem Header="10 秒" Tag="10" IsCheckable="True" Click="RefreshFrequency_Click"/>
                <MenuItem Header="30 秒" Tag="30" IsCheckable="True" Click="RefreshFrequency_Click"/>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
    <Window.Resources>
        <SolidColorBrush x:Key="FloatInk" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="FloatMuted" Color="#9EADC2"/>
        <SolidColorBrush x:Key="FloatSignal" Color="#47D7AC"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#233550"/>
        <SolidColorBrush x:Key="Line" Color="#263750"/>
        <SolidColorBrush x:Key="SignalSoft" Color="#153A34"/>
        <SolidColorBrush x:Key="FloatingShell" Color="#F5111C2D"/>
        <SolidColorBrush x:Key="FloatingPeek" Color="#70384A61"/>
        <SolidColorBrush x:Key="FloatingSecondaryInk" Color="#C5D0DE"/>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FloatMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Cascadia Mono"/>
            <Setter Property="FontSize" Value="{DynamicResource FloatFontButton}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ButtonHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource FloatInk}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResizeThumb" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Panel.ZIndex" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TaskHoverRow" TargetType="Grid">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FloatingHoveredTask}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
    <Border x:Name="Shell" Margin="4" Background="{DynamicResource FloatingShell}" BorderBrush="{DynamicResource Line}"
            BorderThickness="1" CornerRadius="10" MouseLeftButtonDown="Shell_MouseLeftButtonDown">
        <Grid>
            <Grid Margin="8,3,5,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="17"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource FloatSignal}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="BrandText" Text="CODEX / LIVE" Foreground="{DynamicResource FloatSignal}" FontFamily="Cascadia Mono"
                                   FontWeight="SemiBold" FontSize="{DynamicResource FloatFontBrand}"/>
                        <TextBlock x:Name="SyncAgeText" Text="连接中" Foreground="{DynamicResource FloatMuted}"
                                   FontFamily="Cascadia Mono" FontSize="{DynamicResource FloatFontSmall}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="RefreshButton" Content="↻" ToolTip="立即刷新" Style="{StaticResource ChromeButton}" Click="RefreshNow_Click"/>
                        <Button x:Name="PinButton" Content="●" ToolTip="取消置顶" Style="{StaticResource ChromeButton}" Click="PinButton_Click"/>
                        <Button Content="×" ToolTip="关闭悬浮窗" Style="{StaticResource ChromeButton}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="TaskRowsPanel" Grid.Row="1" Margin="0,0,2,1">
                    <Grid x:Name="PrimaryTaskRow" Height="27"
                          MouseLeftButtonDown="TaskRow_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="TaskStatusBadge" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource SignalSoft}" CornerRadius="5" Padding="4,1">
                            <TextBlock x:Name="TaskStatusText" Text="正在连接" Foreground="{DynamicResource FloatSignal}"
                                       FontSize="{DynamicResource FloatFontSmall}" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock x:Name="TaskNameText" Grid.Column="1" Text="读取最近任务…" Foreground="{DynamicResource FloatInk}"
                                   FontSize="{DynamicResource FloatFontTask}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="5,0,0,0" ToolTip="读取最近任务…"/>
                    </Grid>
                    <StackPanel x:Name="SecondaryTasksPanel"/>
                </StackPanel>

                <Border Grid.Row="2" Background="{DynamicResource Line}"/>

                <Grid Grid.Row="3" Margin="0,3,2,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="剩余额度" Foreground="{DynamicResource FloatMuted}" FontSize="{DynamicResource FloatFontSmall}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RemainingQuotaText" Text="--" Foreground="{DynamicResource FloatInk}"
                                       FontFamily="Cascadia Mono" FontSize="{DynamicResource FloatFontQuota}" FontWeight="SemiBold"/>
                            <TextBlock Text="%" Foreground="{DynamicResource FloatMuted}" FontFamily="Cascadia Mono"
                                       FontSize="{DynamicResource FloatFontPercent}" Margin="1,0,0,2" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Line}" Margin="0,1,0,1"/>
                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                        <TextBlock Text="当前推理模型" Foreground="{DynamicResource FloatMuted}" FontSize="{DynamicResource FloatFontSmall}"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ModelText" Text="--" Foreground="{DynamicResource FloatInk}" FontFamily="Cascadia Mono"
                                       FontSize="{DynamicResource FloatFontModel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ReasoningText" Grid.Column="1" Text="" Foreground="{DynamicResource FloatMuted}"
                                       FontFamily="Cascadia Mono" FontSize="{DynamicResource FloatFontSmall}" Margin="4,1,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 无边框浮窗的八向缩放命中区。 -->
            <Thumb Tag="Top" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                   Cursor="SizeNS" Style="{StaticResource ResizeThumb}"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="Bottom" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                   Cursor="SizeNS" Style="{StaticResource ResizeThumb}"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="Left" Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                   Cursor="SizeWE" Style="{StaticResource ResizeThumb}"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="Right" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                   Cursor="SizeWE" Style="{StaticResource ResizeThumb}"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="TopLeft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Cursor="SizeNWSE" Style="{StaticResource ResizeThumb}"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="TopRight" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Cursor="SizeNESW" Style="{StaticResource ResizeThumb}"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="BottomLeft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Cursor="SizeNESW" Style="{StaticResource ResizeThumb}"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="BottomRight" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" Style="{StaticResource ResizeThumb}"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
        </Grid>
    </Border>

    <!-- 靠边收起后唯一保留的轻量触发面；方向由代码随吸附边缘调整。 -->
    <Border x:Name="PeekHandle" Width="8" Height="56" HorizontalAlignment="Left"
            VerticalAlignment="Center" Visibility="Collapsed" Cursor="Hand"
            Background="{DynamicResource FloatingPeek}" BorderThickness="0"
            CornerRadius="6,0,0,6" ToolTip="悬停展开" MouseLeftButtonDown="PeekHandle_MouseLeftButtonDown">
        <Rectangle x:Name="PeekSignal" Width="2" Height="34" RadiusX="1" RadiusY="1" Fill="{DynamicResource FloatSignal}"/>
    </Border>
    </Grid>
</Window>
